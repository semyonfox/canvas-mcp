{
  "name": "canvas-mcp",
  "version": "0.2.0",
  "description": "Unified MCP server for Canvas LMS",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semyonfox/canvas-mcp.git"
  },
  "homepage": "https://github.com/semyonfox/canvas-mcp#readme",
  "bugs": {
    "url": "https://github.com/semyonfox/canvas-mcp/issues"
  },
  "keywords": [
    "canvas",
    "canvas-lms",
    "mcp",
    "model-context-protocol",
    "typescript"
  ],
  "packageManager": "pnpm@11.22.0",
  "bin": {
    "canvas-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ATTRIBUTION.md",
    "TOOL_MANIFEST.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@modelcontextprotocol/client": "^2.0.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
