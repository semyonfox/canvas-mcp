# Configure these together for a private, server-default Canvas connection.
CANVAS_API_TOKEN=
# Example: your-school.instructure.com
CANVAS_DOMAIN=

# Request-scoped X-Canvas-Token/X-Canvas-Domain headers are off by default.
# Enable only with a comma-separated allowlist of Canvas HTTPS hostnames.
# A configured CANVAS_DOMAIN is also allowlisted for a complete header pair.
CANVAS_ALLOW_REQUEST_CREDENTIALS=false
# CANVAS_ALLOWED_DOMAINS=school-a.instructure.com,school-b.instructure.com

# The default is loopback-only. A non-loopback HOST requires MCP_ALLOWED_HOSTS.
HOST=127.0.0.1
# MCP_ALLOWED_HOSTS=mcp.example.com

# Browser origins are denied by default. Set exact HTTP(S) origins, never '*'.
# MCP_ALLOWED_ORIGINS=https://app.example.com

PORT=3001
LOG_LEVEL=info
